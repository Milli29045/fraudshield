
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model App {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  category    String?
  fraudStatus String   @default("Pending")
  createdAt   DateTime @default(now())
  reviews     Review[]
}

model Review {
  id        Int      @id @default(autoincrement())
  content   String
  rating    Int?
  sentiment String?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  appId Int
  app   App @relation(fields: [appId], references: [id], onDelete: Cascade)
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())
}
